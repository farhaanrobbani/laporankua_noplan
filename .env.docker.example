APP_NAME=Laporan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Akun tunggal admin KUA (wajib diubah; startup ditolak jika masih default)
KUA_ADMIN_NAME="Admin KUA"
KUA_ADMIN_EMAIL=admin@example.com
KUA_ADMIN_PASSWORD=ubah-password-admin-ini
KUA_NAME=
KUA_PROVINSI=
KUA_KABKOTA=
KUA_KECAMATAN=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laporan
DB_USERNAME=laporan
# Wajib diganti; startup production ditolak jika kosong/default
DB_PASSWORD=ubah-password-database-ini
DB_PREFIX=
DB_MIGRATIONS_TABLE=migrations

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true jika diakses lewat HTTPS (mis. di belakang reverse proxy TLS)
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=Laporan

IMPORT_MAX_FILE_SIZE=10240
IMPORT_ALLOWED_TYPES=xlsx,xls

# Queue worker timeout 120s; retry_after harus lebih besar.
# Jika timeout worker dinaikkan, naikkan juga nilai ini.
DB_QUEUE_RETRY_AFTER=180

# Image produksi (pin ke versi exact saat deploy)
APP_IMAGE=ghcr.io/farhaanrobbani/laporankua_noplan:1.1.3

# Port host; default hanya loopback untuk reverse proxy di host yang sama
APP_BIND=127.0.0.1
APP_PORT=8080
